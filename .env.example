# Copy to your config directory as .env and fill in from your Xero app
# (developer.xero.com > your app > Configuration):
#
#   mkdir -p ~/.config/xero-api && chmod 700 ~/.config/xero-api
#   cp .env.example ~/.config/xero-api/.env && chmod 600 ~/.config/xero-api/.env
#
# .env is gitignored here, but it belongs in ~/.config/xero-api/, not in this
# checkout. Never commit real values.
XERO_CLIENT_ID=your-client-id-here
XERO_CLIENT_SECRET=your-client-secret-here

# Optional: loopback port for the `xero auth` redirect (default 8723).
# If you change it, register the matching redirect URI in the Xero app portal:
#   http://localhost:<port>/callback
# XERO_REDIRECT_PORT=8723
